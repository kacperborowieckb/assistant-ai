  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@effect/platform-node": "4.1.4",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
