    },
    {
      "table": "notes",
      "name": "notes_open_loop_check",
      "value": "(\"open_loop_kind\" IS NULL AND \"open_loop_state\" IS NULL AND \"open_loop_closed_reason\" IS NULL AND \"open_loop_due_at\" IS NULL) OR (\"open_loop_kind\" IS NOT NULL AND trim(\"open_loop_kind\") <> '' AND \"open_loop_state\" IS 'open' AND \"open_loop_closed_reason\" IS NULL) OR (\"open_loop_kind\" IS NOT NULL AND trim(\"open_loop_kind\") <> '' AND \"open_loop_state\" IS 'closed' AND \"open_loop_closed_reason\" IS NOT NULL AND \"open_loop_closed_reason\" IN ('done', 'dropped', 'replaced'))",
