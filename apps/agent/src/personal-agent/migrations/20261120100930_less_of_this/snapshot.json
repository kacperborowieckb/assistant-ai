    },
    {
      "table": "inbox_events",
      "name": "inbox_events_fields_check",
      "value": "(\"kind\" = 'OwnerMessage' AND \"channel\" IS NOT NULL AND \"channel_update_id\" IS NOT NULL AND \"conversation_id\" IS NOT NULL AND \"channel_message_id\" IS NOT NULL AND \"text\" IS NOT NULL AND \"sent_at\" IS NOT NULL AND \"schedule_id\" IS NULL AND \"due_at\" IS NULL) OR (\"kind\" = 'ScheduleFired' AND \"schedule_id\" IS NOT NULL AND \"due_at\" IS NOT NULL AND \"channel\" IS NULL AND \"channel_update_id\" IS NULL AND \"conversation_id\" IS NULL AND \"channel_message_id\" IS NULL AND \"text\" IS NULL AND \"forward_origin\" IS NULL AND \"sent_at\" IS NULL)",
