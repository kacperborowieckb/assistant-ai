---
// The hero: Billy on his dam in the pixel valley, with the chat around him.
// "Tell Billy." lands, a short pause, then "He'll do it all." The floating
// chat plays everyday exchanges, with Billy saying what he is doing while he
// works (src/scripts/hero.ts). The sun (or moon) switches day and night.
import { ArrowDown, ArrowRight } from "lucide-react";

import { buttonVariants } from "@/components/ui/button";

import { icons, world } from "../art";
import Billy from "./billy.astro";
import Bubble from "./bubble.astro";
import Cloud from "./cloud.astro";
import Confirmation from "./confirmation.astro";
import Header from "./header.astro";
import SkyToggle from "./sky-toggle.astro";
import Stars from "./stars.astro";
import Tile from "./tile.astro";

const stars = [
  { top: "14%", left: "8%", size: 2, delay: 0.1 },
  { top: "22%", left: "21%", size: 1, delay: 0.6 },
  { top: "9%", left: "34%", size: 1, delay: 0.3 },
  { top: "30%", left: "45%", size: 1, delay: 0.8 },
  { top: "12%", left: "58%", size: 2, delay: 0.45 },
  { top: "26%", left: "70%", size: 1, delay: 0.2 },
  { top: "38%", left: "90%", size: 2, delay: 0.7 },
  { top: "44%", left: "4%", size: 1, delay: 0.5 },
  { top: "50%", left: "28%", size: 2, delay: 0.9 },
  { top: "52%", left: "76%", size: 1, delay: 0.35 },
] as const;

// Everyday exchanges the floating chat plays in turn: capture, recall,
// follow-ups, and plans that change. `status` is what Billy says while he
// works. The first is in the markup, so the page reads complete without
// script or with reduced motion.
const conversations = [
  {
    ask: "What's the Wi-Fi password at mum's?",
    status: "Searching your Notes",
    reply: "It's blue-otter-42. You told me in August.",
    icon: icons.note,
    card: "Mum's house · 14 Aug",
    action: "Open",
  },
  {
    ask: "I parked on level 3, spot C14",
    status: "Saving a Note",
    reply: "Saved. Ask me when you're back at the car.",
    icon: icons.note,
    card: "Parking · Level 3, C14",
    action: "Undo",
  },
  {
    ask: "Did Tom ever send the flat contract?",
    status: "Checking your follow-ups",
    reply: "Not yet. You asked him on Tuesday. Should I nudge him tomorrow?",
    icon: icons.reminder,
    card: "Follow up with Tom · Thu 10:00",
    action: "Set",
  },
  {
    ask: "Move the dentist to after 5 on Friday",
    status: "Checking Friday",
    reply: "Done, Friday at 17:30. I'll remind you an hour before.",
    icon: icons.calendar,
    card: "Dentist · Fri 17:30",
    action: "Undo",
  },
  {
    ask: "Remind me to renew my passport before Lisbon",
    status: "Looking at your trip",
    reply: "It expires 5 weeks before you fly. I'll remind you Monday morning.",
    icon: icons.reminder,
    card: "Renew passport · Mon 9:00",
    action: "Undo",
  },
  {
    ask: "Oat milk, eggs, coffee beans",
    status: "Adding to your list",
    reply: "Added. Your shopping list has 7 things now.",
    icon: icons.note,
    card: "Shopping list · 7 items",
    action: "Open",
  },
];

// "Tell Billy." arrives, holds a beat, then the second line.
const words = [
  { text: "Tell", delay: 100 },
  { text: "Billy.", delay: 170, breakAfter: true },
  { text: "He'll", delay: 950 },
  { text: "do", delay: 1010 },
  { text: "it", delay: 1070 },
  { text: "all.", delay: 1130 },
];
---

<Header />

<div class="sky scene" data-hero>
  <Stars stars={[...stars]} />
  <Cloud top="190px" x="4cqw" phase={0.12} />
  <Cloud size="small" top="120px" x="26cqw" phase={0.45} speed={1.5} />
  <Cloud top="340px" x="72cqw" phase={0.7} speed={1.2} />
  <Cloud size="small" top="470px" x="44cqw" phase={0.9} speed={1.7} />

  <div class="celestial">
    <SkyToggle />
  </div>

  <section class="wrap intro" aria-labelledby="hero-title">
    <h1 id="hero-title" class="display-hero headline">
      {
        words.map((word, index) => (
          <>
            <span class="word" style={`--delay: ${word.delay}ms`}>
              {word.text}
            </span>
            {word.breakAfter ? <br /> : index < words.length - 1 ? " " : ""}
          </>
        ))
      }
    </h1>
    <p class="lede rise" style="--d: 1600ms">Notes, Reminders, follow-ups, research, replies, bookings. Whatever you would hand to a great assistant, text it to Billy, and he takes it from there.</p>
    <div class="actions rise" style="--d: 1720ms">
      <a class={buttonVariants({ size: "lg", className: "cta" })} href="#get">
        Get Billy<ArrowRight data-icon="inline-end" className="cta-arrow" />
      </a>
      <a class={buttonVariants({ variant: "link", size: "lg", className: "more px-3" })} href="#how">
        See how it works<ArrowDown data-icon="inline-end" className="more-arrow" />
      </a>
    </div>
  </section>

  <div class="valley">
    <div class="hills hills-light" aria-hidden="true"></div>
    <div class="water water-flow" aria-hidden="true"></div>
    <img class="px log log--left" src={world.log} alt="" width="320" height="88" />
    <img class="px log log--right" src={world.log} alt="" width="320" height="88" />
    <img class="px log log--top" src={world.log} alt="" width="320" height="88" />

    <Billy class="billy" outfit="forest" />

    <img class="px sparkle sparkle--a" src={world.sparkle} alt="" width="24" height="24" />
    <img class="px sparkle sparkle--b" src={world.sparkle} alt="" width="32" height="32" />
    <img class="px sparkle sparkle--c" src={world.sparkle} alt="" width="16" height="16" />

    <!-- One floating thread beside Billy: your message, then his answer right
         under it, in the same spot where he was typing. -->
    <div class="float float--thread" style="--i: 0" aria-hidden="true">
      <div class="bob thread">
        <div class="step step--you" data-step="ask">
          <Bubble from="you" floating><span data-hook="ask">{conversations[0]?.ask}</span></Bubble>
        </div>
        <div class="answer">
        <div class="step step--billy typing" data-step="typing">
          <Bubble from="billy" floating>
            <span class="working"><span class="dots"><span></span><span></span><span></span></span><span data-hook="status">{conversations[0]?.status}</span></span>
          </Bubble>
        </div>
        <div class="step step--billy" data-step="reply">
          <Bubble from="billy" floating>
            <span data-hook="reply">{conversations[0]?.reply}</span>
            <Confirmation icon="note" action="Open" hooks>{conversations[0]?.card}</Confirmation>
          </Bubble>
        </div>
        </div>
      </div>
    </div>
    <script type="application/json" data-conversations set:html={JSON.stringify(conversations)} />
    <div class="float float--note" style="--i: 1" aria-hidden="true">
      <div class="bob"><Tile icon="note" title="Note saved" detail="Packing list" /></div>
    </div>
    <div class="float float--brief" style="--i: 2" aria-hidden="true">
      <div class="bob"><Tile icon="brief" title="Morning Brief" detail="Tomorrow at 8:00" /></div>
    </div>
  </div>
</div>

<style>
  .sky {
    --masthead: 64px;
    position: relative;
    overflow: hidden;
    background: var(--color-sky);
  }

  .celestial {
    position: absolute;
    inset-block-start: calc(var(--masthead) + var(--space-3));
    inset-inline-end: 8%;
    z-index: 2;
  }

  .intro {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    padding-block-start: calc(var(--masthead) + var(--space-7));
    text-align: center;
  }

  .intro .lede {
    max-inline-size: 640px;
    color: var(--color-forest-ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-block-start: var(--space-2);
  }

  .valley {
    position: relative;
    block-size: 600px;
    margin-block-start: calc(-1 * var(--space-5));
  }

  .hills,
  .water {
    position: absolute;
    inset-inline: 0;
  }

  .hills {
    inset-block-end: 56px;
    block-size: 240px;
    background: url("@repo/mascot/assets/world/hills.svg") repeat-x center bottom / auto 100%;
    image-rendering: pixelated;
  }

  .water {
    inset-block-end: 0;
    block-size: 64px;
    background: url("@repo/mascot/assets/world/water.svg") repeat-x left top / auto 100%;
    image-rendering: pixelated;
  }

  .log,
  .sparkle,
  .float,
  .valley :global(.billy) {
    position: absolute;
  }

  .log {
    filter: var(--scenery-light);
  }

  .log--left {
    inset-block-end: 24px;
    inset-inline-start: calc(50% - 300px);
  }

  .log--right {
    inset-block-end: 24px;
    inset-inline-start: calc(50% - 20px);
  }

  .log--top {
    inset-block-end: 104px;
    inset-inline-start: calc(50% - 170px);
  }

  .valley :global(.billy) {
    --mascot-size: 384px;
    inset-block-end: 172px;
    inset-inline-start: calc(50% - 190px);
  }

  .sparkle--a {
    inset-block-start: 150px;
    inset-inline-start: calc(50% - 280px);
  }

  .sparkle--b {
    inset-block-start: 90px;
    inset-inline-start: calc(50% + 200px);
  }

  .sparkle--c {
    inset-block-start: 210px;
    inset-inline-start: calc(50% + 250px);
  }

  /* The thread floats to Billy's right, so his answer sits beside his head. */
  .float--thread {
    inset-block-start: 24px;
    inset-inline-start: calc(50% + 200px);
    inline-size: 380px;
  }

  .thread {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .thread :global(.bubble) {
    max-inline-size: none;
  }

  .thread .step--you {
    align-self: flex-end;
    max-inline-size: 320px;
  }

  /* Typing and the reply share one cell: the answer lands where he typed. */
  .answer {
    display: grid;
    align-items: start;
  }

  .answer > .step {
    grid-area: 1 / 1;
  }

  /* Things Billy already did, to his left. */
  .float--note {
    inset-block-start: 96px;
    inset-inline-end: calc(50% + 250px);
  }

  .float--brief {
    inset-block-start: 196px;
    inset-inline-end: calc(50% + 320px);
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.96);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .float {
      animation: float-in var(--duration-enter) var(--easing-standard) both;
      animation-delay: calc(1850ms + var(--i) * 80ms);
    }

    .bob {
      animation: float var(--duration-bob) var(--easing-float) infinite alternate;
      animation-delay: calc(var(--i) * -2300ms);
    }

    .sparkle {
      animation: twinkle var(--duration-twinkle) var(--easing-float) infinite;
    }

    .sparkle--b {
      animation-delay: -900ms;
    }

    .sparkle--c {
      animation-delay: -1700ms;
    }

  }

  @media (max-width: 1180px) {
    .float--note,
    .float--brief {
      display: none;
    }

    .float--thread {
      inset-inline-start: calc(50% + 170px);
      inline-size: 300px;
    }
  }

  @media (max-width: 900px) {
    .celestial {
      inset-block-start: calc(var(--masthead) - var(--space-2));
      inset-inline-end: var(--space-4);
    }

    .intro {
      padding-block-start: calc(var(--masthead) + 96px);
    }

    .valley {
      block-size: auto;
      padding-block: var(--space-6) 450px;
    }

    .valley :global(.billy) {
      --mascot-size: 256px;
      inset-block-end: 179px;
      inset-inline-start: calc(50% - 120px);
    }


    .float--thread {
      position: relative;
      inset: auto;
      inline-size: auto;
      max-inline-size: 380px;
      margin-inline: auto;
      padding-inline: var(--space-4);
    }

    .sparkle {
      display: none;
    }
  }
  .word {
    display: inline-block;
  }

  /* Chat steps: each bubble grows from the corner it is anchored to. */
  .bob {
    position: relative;
  }

  .step {
    transition:
      opacity var(--duration-standard) var(--easing-standard),
      transform var(--duration-standard) var(--easing-standard),
      filter var(--duration-standard) var(--easing-standard);
  }

  .step--you {
    transform-origin: right bottom;
  }

  .step--billy {
    transform-origin: left top;
  }

  /* While Billy works, he says what he is doing. */
  .working {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-ink-muted);
    font: var(--text-body);
    white-space: nowrap;
  }

  .dots {
    display: inline-flex;
    gap: 4px;
  }

  .dots span {
    inline-size: 6px;
    block-size: 6px;
    border-radius: var(--radius-round);
    background: var(--color-ink-muted);
  }

  /* Without script or with reduced motion the first exchange is simply there,
     and the typing bubble never shows. */
  .typing {
    opacity: 0;
    transform: scale(0.9);
  }

  /* Buttons. */
  .actions :global(.cta) {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .actions :global(.cta)::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      110deg,
      transparent 35%,
      color-mix(in srgb, var(--color-on-forest) 28%, transparent) 50%,
      transparent 65%
    );
    translate: -110% 0;
    pointer-events: none;
  }

  .actions :global(.cta-arrow),
  .actions :global(.more-arrow) {
    transition: translate var(--duration-standard) var(--easing-standard);
  }

  @media (hover: hover) and (pointer: fine) {
    /* The light sweeps across once on hover and snaps back unseen. */
    .actions :global(.cta:hover)::after {
      translate: 110% 0;
      transition: translate 700ms var(--easing-standard);
    }

    .actions :global(.cta:hover .cta-arrow) {
      translate: 4px 0;
    }

    .actions :global(.more:hover .more-arrow) {
      translate: 0 3px;
    }
  }

  @keyframes word-in {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(0.18em);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      filter: blur(4px);
      transform: translateY(12px);
    }
  }

  @keyframes dot-bounce {
    0%,
    60%,
    100% {
      translate: 0 0;
      opacity: 0.45;
    }

    30% {
      translate: 0 -4px;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .word {
      animation: word-in 700ms var(--easing-standard) both;
      animation-delay: var(--delay);
    }

    .rise {
      animation: rise var(--duration-enter) var(--easing-standard) both;
      animation-delay: var(--d);
    }


    .dots span {
      animation: dot-bounce 1100ms var(--easing-float) infinite;
    }

    .dots span:nth-child(2) {
      animation-delay: 150ms;
    }

    .dots span:nth-child(3) {
      animation-delay: 300ms;
    }

    /* With script, the chat plays: steps wait hidden until their turn. */
    :global(.js) .step:not(:global(.is-shown)) {
      opacity: 0;
      transform: translateY(10px) scale(0.94);
      filter: blur(2px);
    }

    :global(.js) .step:global(.is-leaving) {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
      filter: blur(4px);
      transition-duration: var(--duration-quick);
    }

    :global(.js) .typing:global(.is-shown) {
      opacity: 1;
      transform: none;
    }
  }
</style>
