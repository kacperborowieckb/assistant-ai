---
// The hero: the headline in the middle of Billy's sky, small conversations
// floating around it, and Billy on his dam below. "Tell Billy." lands, a
// beat, then "He'll do it all." The conversations then play in one after
// another (src/scripts/hero.ts). The sun (or moon) switches day and night.
import { ArrowDown, ArrowRight } from "lucide-react";

import { buttonVariants } from "@/components/ui/button";

import { world } from "../art";
import Billy from "./billy.astro";
import Cloud from "./cloud.astro";
import Confirmation from "./confirmation.astro";
import Header from "./header.astro";
import ReminderRow from "./reminder-row.astro";
import SkyToggle from "./sky-toggle.astro";
import Stars from "./stars.astro";
import VignetteAnswer from "./vignette-answer.astro";
import VignetteAsk from "./vignette-ask.astro";
import Vignette from "./vignette.astro";

const stars = [
  { top: "14%", left: "8%", size: 2, delay: 0.1 },
  { top: "22%", left: "21%", size: 1, delay: 0.6 },
  { top: "9%", left: "34%", size: 1, delay: 0.3 },
  { top: "30%", left: "45%", size: 1, delay: 0.8 },
  { top: "12%", left: "58%", size: 2, delay: 0.45 },
  { top: "26%", left: "70%", size: 1, delay: 0.2 },
  { top: "38%", left: "90%", size: 2, delay: 0.7 },
  { top: "44%", left: "4%", size: 1, delay: 0.5 },
  { top: "50%", left: "28%", size: 2, delay: 0.9 },
  { top: "52%", left: "76%", size: 1, delay: 0.35 },
] as const;

// "Tell Billy." arrives, holds a beat, then the second line.
const words = [
  { text: "Tell", delay: 100 },
  { text: "Billy.", delay: 170, breakAfter: true },
  { text: "He'll", delay: 950 },
  { text: "do", delay: 1010 },
  { text: "it", delay: 1070 },
  { text: "all.", delay: 1130 },
];
---

<Header />

<div class="sky scene" data-hero>
  <Stars stars={[...stars]} />
  <Cloud top="190px" x="4cqw" phase={0.12} />
  <Cloud size="small" top="120px" x="26cqw" phase={0.45} speed={1.5} />
  <Cloud top="340px" x="72cqw" phase={0.7} speed={1.2} />
  <Cloud size="small" top="470px" x="44cqw" phase={0.9} speed={1.7} />

  <div class="celestial">
    <SkyToggle />
  </div>

  <section class="wrap intro" aria-labelledby="hero-title">
    <h1 id="hero-title" class="display-hero headline">
      {
        words.map((word, index) => (
          <>
            <span class="word" style={`--delay: ${word.delay}ms`}>
              {word.text}
            </span>
            {word.breakAfter ? <br /> : index < words.length - 1 ? " " : ""}
          </>
        ))
      }
    </h1>
    <p class="lede rise" style="--d: 1600ms">Notes, Reminders, follow-ups, research, replies, bookings. Whatever you would hand to a great assistant, text it to Billy, and he takes it from there.</p>
    <div class="actions rise" style="--d: 1720ms">
      <a class={buttonVariants({ size: "lg", className: "cta" })} href="#get">
        Get Billy<ArrowRight data-icon="inline-end" className="cta-arrow" />
      </a>
      <a class={buttonVariants({ variant: "link", size: "lg", className: "more px-3" })} href="#how">
        See how it works<ArrowDown data-icon="inline-end" className="more-arrow" />
      </a>
    </div>
  </section>

  <!-- Four everyday conversations in two mirrored pairs: one pair beside the
       headline, one beside Billy. -->
  <div class="vignettes">
    <Vignette place="tl" tilt={-1} keep>
      <VignetteAsk>What's the Wi-Fi password at mum's?</VignetteAsk>
      <VignetteAnswer status="Searching your Notes">
        It's blue-otter-42. You told me in August.
        <Confirmation icon="note" compact>Mum's house · 14 Aug</Confirmation>
      </VignetteAnswer>
    </Vignette>

    <Vignette place="tr" tilt={1}>
      <VignetteAnswer status="Preparing your Brief">
        Good morning. Three things today:
        <span class="rows">
          <ReminderRow title="Invoice to Marta" time="14:00" />
          <ReminderRow title="Dentist" time="17:30" />
          <ReminderRow title="Call mum" time="18:00" />
        </span>
      </VignetteAnswer>
    </Vignette>

    <Vignette place="bl" tilt={1} keep>
      <VignetteAsk>Remind me to renew my passport before Lisbon</VignetteAsk>
      <VignetteAnswer status="Looking at your trip">
        It runs out five weeks before you fly. I'll remind you Monday at 9:00.
        <Confirmation icon="reminder" compact>Renew passport · Mon 9:00</Confirmation>
      </VignetteAnswer>
    </Vignette>

    <Vignette place="br" tilt={-1}>
      <VignetteAnswer status="Checking your follow-ups">
        Tom still hasn't sent the flat contract. Should I nudge him?
        <span class="chips"><span class="chip">Nudge Tom</span><span class="chip">Wait a day</span></span>
      </VignetteAnswer>
      <VignetteAsk>Yes, tomorrow morning</VignetteAsk>
    </Vignette>
  </div>

  <div class="valley">
    <div class="hills hills-light" aria-hidden="true"></div>
    <div class="water water-flow" aria-hidden="true"></div>
    <img class="px log log--left" src={world.log} alt="" width="320" height="88" />
    <img class="px log log--right" src={world.log} alt="" width="320" height="88" />
    <img class="px log log--top" src={world.log} alt="" width="320" height="88" />

    <Billy class="billy" outfit="forest" />

    <img class="px sparkle sparkle--a" src={world.sparkle} alt="" width="24" height="24" />
    <img class="px sparkle sparkle--b" src={world.sparkle} alt="" width="32" height="32" />
    <img class="px sparkle sparkle--c" src={world.sparkle} alt="" width="16" height="16" />
  </div>
</div>

<style>
  .sky {
    --masthead: 64px;
    position: relative;
    overflow: hidden;
    background: var(--color-sky);
  }

  .celestial {
    position: absolute;
    inset-block-start: calc(var(--masthead) + var(--space-3));
    inset-inline-end: 8%;
    z-index: 2;
  }

  .intro {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    padding-block-start: calc(var(--masthead) + var(--space-7));
    text-align: center;
  }

  .intro .lede {
    max-inline-size: 640px;
    color: var(--color-forest-ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-block-start: var(--space-2);
  }

  /* Two mirrored pairs. Each pair sits at one height, the same distance from
     the center line: left ones hang by their right edge, right ones by their
     left edge. */
  .vignettes :global(.vignette) {
    --gap-from-center: 330px;
    position: absolute;
    z-index: 1;
    inline-size: 280px;
  }

  .vignettes :global(.vignette--tl),
  .vignettes :global(.vignette--bl) {
    inset-inline-end: calc(50% + var(--gap-from-center));
  }

  .vignettes :global(.vignette--tr),
  .vignettes :global(.vignette--br) {
    inset-inline-start: calc(50% + var(--gap-from-center));
  }

  /* The upper pair starts below the sun; the lower pair beside Billy. */
  .vignettes :global(.vignette--tl),
  .vignettes :global(.vignette--tr) {
    inset-block-start: 236px;
  }

  .vignettes :global(.vignette--bl),
  .vignettes :global(.vignette--br) {
    inset-block-start: 596px;
  }

  .rows {
    display: block;
    margin-block-start: calc(-1 * var(--space-1));
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-control-line);
    border-radius: var(--radius-pill);
    color: var(--color-forest);
    font: var(--text-body-strong);
  }

  .valley {
    position: relative;
    block-size: 600px;
    margin-block-start: calc(-1 * var(--space-5));
  }

  .hills,
  .water {
    position: absolute;
    inset-inline: 0;
  }

  .hills {
    inset-block-end: 56px;
    block-size: 240px;
    background: url("@repo/mascot/assets/world/hills.svg") repeat-x center bottom / auto 100%;
    image-rendering: pixelated;
  }

  .water {
    inset-block-end: 0;
    block-size: 64px;
    background: url("@repo/mascot/assets/world/water.svg") repeat-x left top / auto 100%;
    image-rendering: pixelated;
  }

  .log,
  .sparkle,
  .valley :global(.billy) {
    position: absolute;
  }

  .log {
    filter: var(--scenery-light);
  }

  .log--left {
    inset-block-end: 24px;
    inset-inline-start: calc(50% - 300px);
  }

  .log--right {
    inset-block-end: 24px;
    inset-inline-start: calc(50% - 20px);
  }

  .log--top {
    inset-block-end: 104px;
    inset-inline-start: calc(50% - 170px);
  }

  .valley :global(.billy) {
    --mascot-size: 384px;
    inset-block-end: 172px;
    /* Shifted so his head, not the whole sprite with its tail, is centered. */
    inset-inline-start: calc(50% - 230px);
  }

  .sparkle--a {
    inset-block-start: 150px;
    inset-inline-start: calc(50% - 280px);
  }

  .sparkle--b {
    inset-block-start: 90px;
    inset-inline-start: calc(50% + 200px);
  }

  .sparkle--c {
    inset-block-start: 210px;
    inset-inline-start: calc(50% + 250px);
  }

  .word {
    display: inline-block;
  }

  /* Buttons. */
  .actions :global(.cta) {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .actions :global(.cta)::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      110deg,
      transparent 35%,
      color-mix(in srgb, var(--color-on-forest) 28%, transparent) 50%,
      transparent 65%
    );
    translate: -110% 0;
    pointer-events: none;
  }

  .actions :global(.cta-arrow),
  .actions :global(.more-arrow) {
    transition: translate var(--duration-standard) var(--easing-standard);
  }

  @media (hover: hover) and (pointer: fine) {
    /* The light sweeps across once on hover and snaps back unseen. */
    .actions :global(.cta:hover)::after {
      translate: 110% 0;
      transition: translate 700ms var(--easing-standard);
    }

    .actions :global(.cta:hover .cta-arrow) {
      translate: 4px 0;
    }

    .actions :global(.more:hover .more-arrow) {
      translate: 0 3px;
    }
  }

  @keyframes word-in {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(0.18em);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      filter: blur(4px);
      transform: translateY(12px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .word {
      animation: word-in 700ms var(--easing-standard) both;
      animation-delay: var(--delay);
    }

    .rise {
      animation: rise var(--duration-enter) var(--easing-standard) both;
      animation-delay: var(--d);
    }

    /* They float together, so the pairs stay level. */
    .vignettes :global(.bob) {
      animation: float var(--duration-bob) var(--easing-float) infinite alternate;
    }


    .sparkle {
      animation: twinkle var(--duration-twinkle) var(--easing-float) infinite;
    }

    .sparkle--b {
      animation-delay: -900ms;
    }

    .sparkle--c {
      animation-delay: -1700ms;
    }
  }

  /* Smaller laptops: narrower conversations, closer in, and a narrower lede
     between them. */
  @media (max-width: 1279px) {
    .intro .lede {
      max-inline-size: 520px;
    }

    .vignettes :global(.vignette) {
      --gap-from-center: 280px;
      inline-size: 236px;
    }
  }

  /* Narrow screens: two conversations stack above Billy. */
  @media (max-width: 1023px) {
    .vignettes {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      inline-size: min(380px, 100%);
      margin-inline: auto;
      padding: var(--space-7) var(--space-4) 0;
    }

    .vignettes :global(.vignette) {
      position: relative;
      inset: auto;
      inline-size: auto;
    }

    .vignettes :global(.vignette:not(.vignette--keep)) {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .celestial {
      inset-block-start: calc(var(--masthead) - var(--space-2));
      inset-inline-end: var(--space-4);
    }

    .intro {
      padding-block-start: calc(var(--masthead) + 96px);
    }

    .valley {
      block-size: 450px;
    }

    .valley :global(.billy) {
      --mascot-size: 256px;
      inset-block-end: 179px;
      inset-inline-start: calc(50% - 147px);
    }

    .sparkle {
      display: none;
    }
  }
</style>
