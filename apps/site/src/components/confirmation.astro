---
// Card contract, confirmation variant: forest-soft ground, forest-ink text, an
// icon and a plain action.
import type { IconName } from "../art";
import PixelIcon from "./pixel-icon.astro";

interface Props {
  icon: IconName;
  action?: string;
}

const { icon, action } = Astro.props;
---

<div class="confirmation">
  <PixelIcon name={icon} scale={2} />
  <span class="text"><slot /></span>
  {action && <button type="button" class="action">{action}</button>}
</div>

<style>
  .confirmation {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-forest-soft);
    color: var(--color-forest-ink);
  }

  .text {
    flex: 1;
    font: var(--text-body-strong);
  }

  .action {
    min-block-size: var(--size-touch);
    padding-inline: var(--space-3);
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--color-forest);
    font: var(--text-body-strong);
    cursor: pointer;
  }
</style>
