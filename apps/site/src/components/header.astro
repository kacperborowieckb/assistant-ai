---
import { billy } from "../art";
---

<div class="masthead" data-masthead>
  <header class="wrap header">
    <a class="brand" href="/">
      <span class="mascot mascot--portrait logo"><img class="px" src={billy.portrait} alt="" width="40" height="40" /></span>
      <span>Billy</span>
    </a>
    <nav aria-label="Main">
      <ul>
        <li class="optional"><a href="/#how">How it works</a></li>
        <li class="optional"><a href="/#privacy">Privacy</a></li>
        <li class="optional"><a href="/#self-host">Self-host</a></li>
        <li><a class="button button--secondary" href="/#get">Get Billy</a></li>
      </ul>
    </nav>
  </header>
</div>

<style>
  /* Fixed over the sky. Once the page scrolls, it becomes a translucent
     material with a soft edge (apple-design: materials, scroll edge). */
  .masthead {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 20;
    border-block-end: 1px solid transparent;
    transition:
      background-color var(--duration-standard) var(--easing-standard),
      border-color var(--duration-standard) var(--easing-standard),
      backdrop-filter var(--duration-standard) var(--easing-standard);
  }

  .masthead:global(.is-scrolled) {
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
    border-block-end-color: var(--color-line);
    backdrop-filter: blur(18px) saturate(1.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
  }

  @media (prefers-reduced-transparency: reduce) {
    .masthead:global(.is-scrolled) {
      background: var(--color-surface);
      backdrop-filter: none;
    }
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    transition: padding-block var(--duration-standard) var(--easing-standard);
  }

  .masthead:not(:global(.is-scrolled)) .header {
    padding-block: var(--space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--size-touch);
    color: var(--color-ink);
    font: var(--text-heading);
    letter-spacing: var(--text-heading-tracking);
    text-decoration: none;
  }

  .logo {
    --mascot-size: 40px;
    background: var(--color-avatar-ground);
    transition: rotate var(--duration-standard) var(--easing-pop);
  }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover .logo {
      rotate: -10deg;
    }
  }

  ul {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li > a:not(.button) {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-block-size: var(--size-touch);
    padding-inline: var(--space-3);
    color: var(--color-forest-ink);
    font: var(--text-label-lg);
    font-weight: 500;
    text-decoration: none;
  }

  /* The underline grows from the left on hover. */
  li > a:not(.button)::after {
    content: "";
    position: absolute;
    inset-inline: var(--space-3);
    inset-block-end: 10px;
    block-size: 2px;
    border-radius: var(--radius-pill);
    background: currentcolor;
    scale: 0 1;
    transform-origin: left;
    transition: scale var(--duration-standard) var(--easing-standard);
  }

  @media (hover: hover) and (pointer: fine) {
    li > a:not(.button):hover::after {
      scale: 1 1;
    }
  }

  @media (max-width: 760px) {
    .optional {
      display: none;
    }
  }
</style>
