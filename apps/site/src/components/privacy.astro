---
import { billy, world } from "../art";

const promises = [
  { title: "A home of its own", text: "Your Notes and Reminders live in storage that belongs to you alone, never mixed with anyone else's." },
  { title: "Forget means gone", text: "Ask Billy to forget something and it is deleted, not hidden. You can read everything he keeps." },
  { title: "Only what he can confirm", text: "Billy never says done or sent unless it is. If something fails, he tells you." },
];
---

<section id="privacy" class="band" aria-labelledby="privacy-title">
  <div class="wrap section inner">
    <div class="portrait" aria-hidden="true" data-reveal>
      <img class="px frame" src={world.frame} alt="" width="160" height="160" />
      <img class="px face" src={billy.portrait} alt="" width="112" height="112" />
    </div>
    <p class="eyebrow">Privacy</p>
    <h2 id="privacy-title" class="display-section">Yours to keep, or Forget.</h2>
    <ul>
      {
        promises.map((promise) => (
          <li data-reveal>
            <h3 class="heading">{promise.title}</h3>
            <p>{promise.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .band {
    background: var(--color-surface-sunken);
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    text-align: center;
  }

  .portrait {
    position: relative;
    inline-size: 160px;
    block-size: 160px;
    margin-block-end: var(--space-3);
  }

  .frame,
  .face {
    position: absolute;
  }

  .frame {
    inset: 0;
  }

  .face {
    inset-block-start: 24px;
    inset-inline-start: 24px;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    inline-size: 100%;
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    text-align: start;
  }

  li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line);
  }

  li p {
    color: var(--color-ink-muted);
  }

  @media (max-width: 860px) {
    ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
