---
const questions = [
  { q: "Where do I talk to Billy?", a: "In a chat app you already use. Telegram works today. An iPhone app with the same chat is on the way." },
  { q: "Does Billy message me first?", a: "Yes, when he can help: a morning Brief and follow-ups on open items, within your quiet hours and a daily limit. Tell him “less of this” and he listens." },
  { q: "Can I see what he remembers?", a: "Yes. Ask him what he knows about anything, and he names the Note it came from. Forget deletes it." },
  { q: "What does it cost to self-host?", a: "The Cloudflare Workers Paid plan, $5 per month, covers one person. You pay your model provider directly." },
];
---

<section id="faq" class="wrap section faq" aria-labelledby="faq-title">
  <h2 id="faq-title" class="display-section">Questions</h2>
  <div class="list">
    {
      questions.map((item) => (
        <details>
          <summary class="heading">{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--space-8);
    align-items: start;
  }

  details {
    border-block-end: 1px solid var(--color-line);
  }

  details:first-child {
    border-block-start: 1px solid var(--color-line);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-block-size: var(--size-touch);
    padding-block: var(--space-5);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "+";
    color: var(--color-bark);
    font: var(--text-title);
    transition: transform var(--duration-quick) var(--easing-standard);
  }

  details[open] summary::after {
    transform: rotate(45deg);
  }

  details p {
    max-inline-size: var(--size-measure);
    padding-block-end: var(--space-5);
    color: var(--color-ink-muted);
  }

  @media (max-width: 860px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
</style>
