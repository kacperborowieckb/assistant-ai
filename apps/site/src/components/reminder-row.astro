---
// Card contract, reminder-row variant: open circle, title in ink, time in
// ink-muted with tabular figures.
interface Props {
  title: string;
  time: string;
}

const { title, time } = Astro.props;
---

<div class="reminder">
  <span class="circle" aria-hidden="true"></span>
  <span class="title">{title}</span>
  <span class="time">{time}</span>
</div>

<style>
  .reminder {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-2);
  }

  .reminder + :global(.reminder) {
    border-block-start: 1px solid var(--color-line);
  }

  .circle {
    inline-size: 18px;
    block-size: 18px;
    flex: none;
    border: 1.5px solid var(--color-control-line);
    border-radius: var(--radius-round);
  }

  .title {
    flex: 1;
    font: var(--text-body);
  }

  .time {
    font: var(--text-body);
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
