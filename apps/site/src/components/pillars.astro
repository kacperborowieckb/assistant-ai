---
import type { IconName } from "../art";
import PixelIcon from "./pixel-icon.astro";

const pillars: { icon: IconName; title: string; text: string }[] = [
  { icon: "note", title: "Notes", text: "Say it once. Billy files it and finds it again when you ask." },
  { icon: "reminder", title: "Reminders", text: "A nudge at the right time, set in plain words." },
  { icon: "brief", title: "Brief", text: "Your day, every morning, before you think to look." },
];
---

<section class="wrap pillars" aria-label="What Billy keeps for you">
  <ul>
    {
      pillars.map((pillar) => (
        <li>
          <PixelIcon name={pillar.icon} scale={4} />
          <h2 class="heading">{pillar.title}</h2>
          <p>{pillar.text}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .pillars {
    padding-block: var(--space-8) var(--space-6);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--color-line);
  }

  p {
    color: var(--color-ink-muted);
  }

  @media (max-width: 760px) {
    ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
