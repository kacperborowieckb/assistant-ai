---
import BriefArt from "../components/brief-art.astro";
import CaptureArt from "../components/capture-art.astro";
import Closing from "../components/closing.astro";
import Faq from "../components/faq.astro";
import Feature from "../components/feature.astro";
import Footer from "../components/footer.astro";
import Hero from "../components/hero.astro";
import Pillars from "../components/pillars.astro";
import PixelIcon from "../components/pixel-icon.astro";
import Privacy from "../components/privacy.astro";
import SelfHost from "../components/self-host.astro";
import WorkArt from "../components/work-art.astro";
import Base from "../layouts/base.astro";
---

<Base
  title="Billy — a personal agent you text"
  description="Notes, reminders, and follow-ups in one chat. Billy remembers what you tell him, starts the conversation when he can help, and does the work."
>
  <Hero />
  <main id="main">
    <Pillars />

    <Feature id="how" eyebrow="Capture and Recall" title="Say it once. Billy files it.">
      <p>Text Billy the way you would text a colleague. He turns it into a Note or a Reminder, and when you ask later he answers in plain words and names where it came from.</p>
      <ul>
        <li><PixelIcon name="note" scale={3} /><div><strong>One message to capture</strong><span>No forms, no folders, no app to open first.</span></div></li>
        <li><PixelIcon name="search" scale={3} /><div><strong>Ask, and he finds it</strong><span>Recall searches everything you told him.</span></div></li>
      </ul>
      <CaptureArt slot="art" />
    </Feature>

    <Feature eyebrow="Proactive" title="Billy comes to you." reverse tone="honey">
      <p>Every morning a short Brief: what is due, what is waiting on someone, what you asked him to watch. Between Briefs he follows up on open items, and only when it helps.</p>
      <ul>
        <li><PixelIcon name="brief" scale={3} /><div><strong>A Brief at 8:00</strong><span>Your day in one message, at the time you choose.</span></div></li>
        <li><PixelIcon name="reminder" scale={3} /><div><strong>Quiet hours, respected</strong><span>A daily limit, merged messages, and “less of this” when you want fewer.</span></div></li>
      </ul>
      <BriefArt slot="art" />
    </Feature>

    <Feature eyebrow="Actions" title="Then he does the work.">
      <p>Billy searches the web, drafts the reply, and books the table. Anything you cannot take back waits for your yes.</p>
      <ul>
        <li><PixelIcon name="web" scale={3} /><div><strong>Works where you work</strong><span>Calendar, email, the web, and the tools you connect.</span></div></li>
        <li><PixelIcon name="connector" scale={3} /><div><strong>You approve what matters</strong><span>Sending and booking ask first. Undo is always one tap.</span></div></li>
      </ul>
      <WorkArt slot="art" />
    </Feature>

    <Privacy />
    <SelfHost />
    <Faq />
    <Closing />
  </main>
  <Footer />
</Base>
