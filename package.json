{
  "name": "@repo/workspace",
  "private": true,
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "verify": "pnpm check && pnpm verify:foundation && pnpm verify:workspaces",
    "verify:foundation": "node tools/verify-foundation.mjs",
    "verify:workspaces": "pnpm --recursive --filter './apps/*' --filter './packages/*' --if-present run verify"
  },
  "devDependencies": {
    "lefthook": "2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "turbo": "2.11.11",
    "ultracite": "8.2.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@9.15.4"
}
